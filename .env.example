# ================================================================
# GeoRepo Geological Field-to-Report Automation System
# Environment & API Key Configuration Template
# ================================================================

# 1. Speech-to-Text Transcription (OpenAI Whisper)
# Required for real-time cloud acoustic transcription of geological dictations.
# If omitted or offline, the system uses built-in geological domain simulation.
VITE_OPENAI_API_KEY=your_openai_api_key_here

# 2. LLM Structured Entity Extraction Engine (OpenRouter)
# Required for LLM conversion of raw speech transcripts into multi-discipline JSON schemas.
# If omitted or offline, the system uses the deterministic domain rule parser.
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. NVIDIA NIM Microservices (Alternative LLM Provider)
# Set when using NVIDIA NIM endpoints (e.g. meta/llama-3.1-70b-instruct).
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here

# 4. Optional Custom Transcription / LLM Endpoints
# VITE_WHISPER_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
# VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# VITE_NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
